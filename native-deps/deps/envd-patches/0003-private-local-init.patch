+package main
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+	"time"
+)
+
+type localInitListener struct {
+	net.Listener
+	lock *os.File
+	once sync.Once
+	err  error
+}
+
+func (l *localInitListener) Close() error {
+	l.once.Do(func() { l.err = l.Listener.Close(); l.lock.Close() })
+	return l.err
+}
+
+// The lifetime lock serializes restarts. Remove only an owned, refused stale
+// socket left after a crash, never a live listener or a substituted pathname.
+func listenLocalInit(dir string) (net.Listener, error) {
+	if err := os.Mkdir(dir, 0700); err != nil && !os.IsExist(err) {
+		return nil, err
+	}
+	st, err := os.Lstat(dir)
+	if err != nil {
+		return nil, err
+	}
+	owner, ok := st.Sys().(*syscall.Stat_t)
+	if !st.IsDir() || st.Mode().Perm() != 0700 || !ok || owner.Uid != uint32(os.Geteuid()) {
+		return nil, fmt.Errorf("unsafe init directory")
+	}
+	fd, err := syscall.Open(filepath.Join(dir, "owner.lock"), syscall.O_RDWR|syscall.O_CREAT|syscall.O_CLOEXEC|syscall.O_NOFOLLOW, 0600)
+	if err != nil {
+		return nil, err
+	}
+	lock := os.NewFile(uintptr(fd), "init-lock")
+	keep := false
+	defer func() {
+		if !keep {
+			lock.Close()
+		}
+	}()
+	if err = syscall.Flock(fd, syscall.LOCK_EX|syscall.LOCK_NB); err != nil {
+		return nil, err
+	}
+	path := filepath.Join(dir, "init.sock")
+	if st, err := os.Lstat(path); err == nil {
+		owner, ok := st.Sys().(*syscall.Stat_t)
+		if st.Mode()&os.ModeSocket == 0 || !ok || owner.Uid != uint32(os.Geteuid()) {
+			return nil, errors.New("unsafe init socket")
+		}
+		c, dialErr := net.DialTimeout("unix", path, 100*time.Millisecond)
+		if dialErr == nil {
+			c.Close()
+			return nil, errors.New("init listener already running")
+		}
+		if !errors.Is(dialErr, syscall.ECONNREFUSED) {
+			return nil, dialErr
+		}
+		current, err := os.Lstat(path)
+		if err != nil {
+			return nil, err
+		}
+		if !os.SameFile(st, current) {
+			return nil, errors.New("init socket changed")
+		}
+		if err = os.Remove(path); err != nil {
+			return nil, err
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, err
+	}
+	l, err := net.Listen("unix", path)
+	if err != nil {
+		return nil, err
+	}
+	if err = os.Chmod(path, 0600); err != nil {
+		l.Close()
+		return nil, err
+	}
+	keep = true
+	return &localInitListener{Listener: l, lock: lock}, nil
+}
