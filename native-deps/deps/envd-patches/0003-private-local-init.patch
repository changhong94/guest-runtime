+package main
+
+import (
+	"net"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestLocalInitListener(t *testing.T) {
+	d := filepath.Join(t.TempDir(), "private")
+	l, e := listenLocalInit(d)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	if st, e := os.Stat(filepath.Join(d, "init.sock")); e != nil || st.Mode().Perm() != 0600 {
+		t.Fatal("socket not private")
+	}
+	if other, e := listenLocalInit(d); e == nil {
+		other.Close()
+		t.Fatal("replaced live socket")
+	}
+}
+func TestLocalInitRejectsUnsafeDir(t *testing.T) {
+	d := filepath.Join(t.TempDir(), "unsafe")
+	os.Mkdir(d, 0755)
+	if l, e := listenLocalInit(d); e == nil {
+		l.Close()
+		t.Fatal("unsafe dir accepted")
+	}
+	s := filepath.Join(t.TempDir(), "link")
+	os.Symlink(d, s)
+	if l, e := listenLocalInit(s); e == nil {
+		l.Close()
+		t.Fatal("symlink accepted")
+	}
+}
+func TestLocalInitRecoversStaleSocket(t *testing.T) {
+	d := filepath.Join(t.TempDir(), "private")
+	if e := os.Mkdir(d, 0700); e != nil {
+		t.Fatal(e)
+	}
+	stale, e := net.ListenUnix("unix", &net.UnixAddr{Name: filepath.Join(d, "init.sock"), Net: "unix"})
+	if e != nil {
+		t.Fatal(e)
+	}
+	stale.SetUnlinkOnClose(false)
+	stale.Close()
+	l, e := listenLocalInit(d)
+	if e != nil {
+		t.Fatal(e)
+	}
+	l.Close()
+	l, e = listenLocalInit(d)
+	if e != nil {
+		t.Fatal(e)
+	}
+	l.Close()
+}
